    {
      "name": "03-Cart",
      "item": [
        {
          "name": "Add product to cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is successful\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "",
                  "pm.test(\"Correct user ID is returned\", function () {",
                  "    pm.expect(data.userId).to.eql(1);",
                  "});",
                  "",
                  "pm.test(\"Product is added with correct quantity\", function () {",
                  "    pm.expect(data.products[0].id).to.eql(1);",
                  "    pm.expect(data.products[0].quantity).to.eql(2);",
                  "});",
                  "",
                  "pm.test(\"Product total is calculated correctly\", function () {",
                  "    const data = pm.response.json();",
                  "    const product = data.products[0];",
                  "",
                  "    const expectedTotal = product.price * product.quantity;",
                  "",
                  "    pm.expect(product.total).to.eql(expectedTotal);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"products\": [\n    {\n      \"id\": 1,\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/carts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "1"
              ]
            }
          },
          "response": []
        }
      ]
