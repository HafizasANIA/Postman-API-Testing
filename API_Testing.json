      "name": "01 - Authentication",
      "item": [
        {
          "name": "TC_AUTH_001 - Valid Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", ()=>{",
                  "    pm.response.to.have.status(200)",
                  "})",
                  "",
                  "pm.test(\"Username is Correct\", ()=>{",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.username).to.eql(\"emilys\");",
                  "});",
                  "",
                  "pm.test(\"Access token is returned\", ()=>{",
                  "",
                  "    const data= pm.response.json();",
                  "    pm.expect(data.accessToken).to.exist;",
                  "});",
                  "",
                  "pm.test(\"Refresh token is returned,\", ()=> {",
                  "",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.refreshToken).to.exist;",
                  "})",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.environment.set(\"accessToken\", jsonData.accessToken);",
                  "pm.environment.set(\"userId\", jsonData.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"emilys\",\n  \"password\": \"emilyspass\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
